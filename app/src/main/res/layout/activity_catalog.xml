<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    tools:context=".CatalogActivity">

    <!-- CABECERA SUPERIOR CON TÍTULO Y CAMBIO DE VISTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnBackCatalog"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regresar"
                android:src="@drawable/arrowback_24"
                app:tint="#0F172A" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/btnBackCatalog"
                android:layout_toStartOf="@id/btnToggleView"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCatalogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Especialistas Cerca de Ti"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCatalogSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Selecciona el profesional ideal para tu necesidad"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- BOTÓN CONMUTADOR DE VISTA (LISTA / MALLA 2 COLUMNAS) -->
            <ImageButton
                android:id="@+id/btnToggleView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cambiar Vista"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_grid_view"
                app:tint="#2563EB" />

        </RelativeLayout>

        <!-- SECCIÓN DE BÚSQUEDA Y FILTROS MODAL ENTERPRISE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F8FAFC"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/icSearchCatalog"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search"
                    app:tint="#2563EB" />

                <EditText
                    android:id="@+id/etSearchCatalog"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_toEndOf="@id/icSearchCatalog"
                    android:layout_toStartOf="@id/btnFilterTune"
                    android:background="@null"
                    android:hint="Buscar por especialista o servicio..."
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnFilterTune"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_blue"
                    android:contentDescription="Abrir Filtros"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_filter_tune"
                    app:tint="#2563EB" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PÍLDORAS DE FILTROS ACTIVOS CON BOTÓN 'X' PARA DESCARTAR -->
        <HorizontalScrollView
            android:id="@+id/scrollActiveChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/containerActiveChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- CONTADOR DE RESULTADOS ENCONTRADOS -->
        <TextView
            android:id="@+id/tvResultsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mostrando 8 especialistas encontrados"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- LISTADO / MALLA DE PROVEEDORES DE SERVICIOS -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCatalogProfessionals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp" />

        <!-- ESTADO VACÍO -->
        <LinearLayout
            android:id="@+id/layoutEmptyCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_search"
                app:tint="#94A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No se encontraron profesionales"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Prueba cambiando los términos de búsqueda o el filtro seleccionado."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>