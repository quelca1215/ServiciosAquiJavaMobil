<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_enterprise"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- INDICADOR SUPERIOR -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CBD5E1" />

    <!-- TITULO -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvFilterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtros Avanzados de Búsqueda"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnResetFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:text="Limpiar Todo"
            android:textColor="#2563EB"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Selecciona las características requeridas para filtrar especialistas"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- OPCIÓN 1: DISTANCIA MÁXIMA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Distancia Máxima"
        android:textColor="#0F172A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chkFilterNear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter"
        android:text="Cerca de mi ubicación (&lt; 2 km)"
        android:textColor="#334155"
        android:textSize="13sp" />

    <!-- OPCIÓN 2: CALIFICACIÓN MÍNIMA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Calificación del Prestador"
        android:textColor="#0F172A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chkFilterTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter"
        android:text="Excelentes valoraciones (4.8 estrellas o más)"
        android:textColor="#334155"
        android:textSize="13sp" />

    <!-- OPCIÓN 3: DISPONIBILIDAD -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Disponibilidad de Atención"
        android:textColor="#0F172A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chkFilterAvailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter"
        android:text="Atención e interacción inmediata hoy"
        android:textColor="#334155"
        android:textSize="13sp" />

    <!-- OPCIÓN 4: PRECIO ESTIMADO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tarifa Estimada"
        android:textColor="#0F172A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chkFilterBudget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter"
        android:text="Tarifas económicas (&lt; Bs. 50 / cotizar)"
        android:textColor="#334155"
        android:textSize="13sp" />

    <!-- BOTÓN APLICAR FILTROS -->
    <Button
        android:id="@+id/btnApplyFilters"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#2563EB"
        android:fontFamily="@font/inter"
        android:text="Aplicar Filtros Seleccionados"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

</LinearLayout>